generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

// ── Models ───────────────────────────────────────────────────

model Lead {
  id            String     @id @default(cuid())
  fullName      String
  email         String
  whatsapp      String
  message       String
  instagramLink String?
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("leads")
}

enum LeadStatus {
  NEW
  VIEWED
  CONTACTED
  CONVERTED
  ARCHIVED
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model PageView {
  id    String @id @default(cuid())
  date  String @unique
  count Int    @default(1)

  @@map("page_views")
}
